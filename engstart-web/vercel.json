{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/dictionary.js": {
      "maxDuration": 55
    },
    "api/video-translate.js": {
      "maxDuration": 45
    },
    "api/video-cues.js": {
      "maxDuration": 50
    }
  }
}
